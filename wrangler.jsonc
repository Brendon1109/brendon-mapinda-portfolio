{
  // Static assets only. There is no Worker script and no build step, which is the
  // whole point of this repo: the HTML in git is the HTML that is served.
  "name": "brendon-mapinda-portfolio",
  "compatibility_date": "2026-08-07",

  // Added 27 August 2026. This repo was static assets with no script, which
  // meant no server, which meant no way to set the first party cookie that
  // recognises a returning visitor on an iPhone. The script serves /api/e and
  // hands every other request straight to ASSETS, so the site is unchanged.
  "main": "src/worker.ts",

  "vars": {
    "BZ_SITE": "portfolio"
  },

  // A Worker CANNOT fetch another Worker over its *.workers.dev hostname on the
  // same account. The edge short-circuits it and returns a 404 that never
  // reaches the target, which reads exactly like a routing bug in your own
  // code. A service binding calls the collector's fetch handler directly, with
  // no network hop and no subrequest cost.
  "services": [
    { "binding": "COLLECTOR", "service": "breazy-analytics" }
  ],

  "assets": {
    // Named so the Worker script can fall through to it. Reserved in Pages
    // projects, which is one more reason everything here is a Worker.
    "binding": "ASSETS",

    // Everything under public/ is served at a public URL and nothing outside it
    // is. That boundary is a directory rather than an ignore list on purpose:
    // pointing this at the repo root uploaded .git and .vercel/project.json too,
    // and an ignore list is one forgotten line away from doing it again.
    "directory": "./public",

    // Default behaviour, written out so nobody has to look it up. A request for
    // /studio serves studio.html, and /studio.html 307s to /studio. Every
    // canonical, og:url and sitemap entry in this repo uses the extensionless
    // form, so the redirect only ever fires for an old inbound link.
    "html_handling": "auto-trailing-slash",

    // No 404.html in the repo, so an unknown path gets a plain 404 rather than
    // a soft 200. Add a 404.html and switch this to "404-page" if that changes.
    "not_found_handling": "none"
  }
}
